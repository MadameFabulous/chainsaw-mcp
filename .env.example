# Chainsaw MCP configuration. Remote HTTPS requires TLS/auth; uploads require signing trust.
# Root used for relative defaults below (default: current working directory).
# Set it explicitly for a service unit so paths do not depend on the working directory.
#CHAINSAW_HOME=/srv/chainsaw-mcp
# Chainsaw binary. Default: $CHAINSAW_HOME/vendor/chainsaw/chainsaw, then `chainsaw` on PATH.
#CHAINSAW_BIN=/usr/local/bin/chainsaw
# Rule locations (defaults under $CHAINSAW_HOME/vendor/chainsaw as installed by chainsaw-mcp-bootstrap).
#CHAINSAW_RULES_DIR=vendor/chainsaw/rules
#CHAINSAW_SIGMA_DIR=vendor/chainsaw/sigma
#CHAINSAW_MAPPINGS_DIR=vendor/chainsaw/mappings
# Analyst-authored rules written by chainsaw_save_rule and usable via extra_rules=["custom"].
#CHAINSAW_CUSTOM_RULES_DIR=custom-rules
# Colon-separated directories that tools may read evidence from. Default: ./evidence. Paths outside these roots are rejected.
#CHAINSAW_EVIDENCE_ROOTS=/srv/evidence:/srv/chainsaw-mcp/evidence
# Where paged result files (server-minted handles) are stored.
#CHAINSAW_OUTPUT_DIR=.chainsaw-mcp/results
# Per-invocation timeout in seconds, thread limit, paging cap and default inline preview size.
#CHAINSAW_TIMEOUT=600
#CHAINSAW_THREADS=4
#CHAINSAW_MAX_PAGE=500
#CHAINSAW_PREVIEW=20
# Streamable HTTP Host/Origin allow-list additions, comma-separated (see README and docs/deployment.md).
# The bind host, localhost and 127.0.0.1 are always accepted; add the names clients use.
#MCP_ALLOWED_HOSTS=mcp-host.example.ts.net:*
#MCP_ALLOWED_ORIGINS=

# Remote HTTP always requires authentication; stdio ignores it.
# Set exactly one token source; tokens must have at least 32 ASCII characters, no whitespace.
#MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_token
#MCP_AUTH_TOKEN=
# Remote listener requires native TLS and bearer auth; local stdio needs neither.
#MCP_TLS_CERT_FILE=/run/secrets/tls_cert
#MCP_TLS_KEY_FILE=/run/secrets/tls_key
# Trusted CA/certificate for the HTTPS health probe. Certificate needs a 127.0.0.1 SAN
# for the default container probe, plus each remote DNS/IP name clients actually use.
#MCP_TLS_CA_FILE=/run/secrets/tls_ca
# Compose host settings (not paths on an MCP client's computer).
#MCP_BIND_ADDRESS=127.0.0.1
#MCP_PORT=18098
#CHAINSAW_EVIDENCE_PATH=/srv/cases
#MCP_AUTH_TOKEN_SOURCE=./secrets/mcp_token
#MCP_TLS_CERT_SOURCE=./secrets/tls.crt
#MCP_TLS_KEY_SOURCE=./secrets/tls.key
#MCP_TLS_CA_SOURCE=./secrets/tls.crt
#CHAINSAW_TRANSFER_SIGNING_KEY_SOURCE=./secrets/server-signing.key
#CHAINSAW_UPLOAD_TRUST_SOURCE=./secrets/upload-trust

# Remote uploads: disabled unless set; image defaults to /data/uploads.
# Must be separate from mounted evidence roots. Verified files become an additional root.
#CHAINSAW_UPLOAD_DIR=/data/uploads
#CHAINSAW_UPLOAD_MAX_BYTES=2147483648
#CHAINSAW_UPLOAD_QUOTA_BYTES=10737418240
# Required for uploads: directory of independently approved Ed25519 public .pem keys.
#CHAINSAW_UPLOAD_TRUSTED_KEYS_DIR=/run/upload-trust
# Required for signed downloads and custody records: server's Ed25519 private PEM key.
#CHAINSAW_TRANSFER_SIGNING_KEY_FILE=/run/secrets/transfer_signing_key
# Optional additional custody manifest signers; current server key is trusted automatically.
# Keep these public .pem keys outside evidence mounts. See docs/custody.md for Compose setup.
#CHAINSAW_CUSTODY_TRUSTED_KEYS_DIR=/run/custody-trust

# Optional Jev result triage (docs/jev.md). Explicit calls send selected evidence fields to TypeSafe.
# Disabled by default; credentials alone do not enable external calls.
#CHAINSAW_JEV_ENABLED=false
#JEV_MODEL=jev-latest
#CHAINSAW_JEV_TIMEOUT=30
# Prefer a Bitwarden Secrets Manager (bws) secret ID, fetched at call time, or inject
# TYPESAFE_API_KEY from your own secret manager.
#CHAINSAW_JEV_BWS_SECRET_ID=<uuid-of-jev-api-key>
#TYPESAFE_API_KEY=
#BWS_BINARY=bws
#BWS_TOKEN_FILE=~/.config/bitwarden-sm/token
# Alternatively inject BWS_ACCESS_TOKEN. Token files must be private (0600).
